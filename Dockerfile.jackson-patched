ARG BUILDER_IMAGE=maven:3.9-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320
ARG BASE_IMAGE=docker.elastic.co/elasticsearch/elasticsearch-wolfi:9.4.8-amd64@sha256:8f501c3cee2553e2acc4383554f0ab59e28789a1066f5969eea5118e7966225e

FROM ${BUILDER_IMAGE} AS dependency-patches

ARG PARQUET_HADOOP_BUNDLE_VERSION=1.18.1
ARG PARQUET_SHADED_JACKSON_VERSION=2.22.3
ARG PARQUET_SHADED_JACKSON_ANNOTATIONS_VERSION=2.22
ARG LZ4_VERSION=1.11.4
ARG JSOUP_VERSION=1.23.2
ARG TIKA_VERSION=3.3.2
ARG MAVEN_BASE_URL=https://repo1.maven.org/maven2

COPY patches/parquet-jackson-shade-pom.xml /tmp/parquet-jackson-patch/pom.xml

RUN set -eu; \
    download_verified() { \
      path="$1"; \
      expected_sha512="$2"; \
      output="$3"; \
      curl -fsSL --retry 3 --retry-delay 2 -o "${output}" "${MAVEN_BASE_URL}/${path}"; \
      actual_sha512="$(sha512sum "${output}" | awk '{print $1}')"; \
      if [ "${expected_sha512}" != "${actual_sha512}" ]; then \
        echo "SHA-512 mismatch for ${path}" >&2; \
        echo "expected: ${expected_sha512}" >&2; \
        echo "actual:   ${actual_sha512}" >&2; \
        exit 1; \
      fi; \
    }; \
    workdir=/tmp/parquet-jackson-patch; \
    cd "${workdir}"; \
    parquet_jar="parquet-hadoop-bundle-${PARQUET_HADOOP_BUNDLE_VERSION}.jar"; \
    download_verified \
      "org/apache/parquet/parquet-hadoop-bundle/${PARQUET_HADOOP_BUNDLE_VERSION}/${parquet_jar}" \
      d032eb1e8a30fc527e5cb743d23f87f54a8c2763b810e00505ff3a0dfb2930a902eac6dae272959557b36b6e8b23712383c1cebcdaede04fa7e3706a0c3be234 \
      "${parquet_jar}"; \
    mvn -q \
      -Djackson.version="${PARQUET_SHADED_JACKSON_VERSION}" \
      -Djackson.annotations.version="${PARQUET_SHADED_JACKSON_ANNOTATIONS_VERSION}" \
      -DskipTests \
      package; \
    mkdir original relocated out; \
    (cd original && jar xf "../${parquet_jar}"); \
    (cd relocated && jar xf ../target/parquet-jackson-relocator-1.0.0-relocated.jar); \
    rm -rf original/shaded/parquet/com/fasterxml/jackson; \
    rm -rf original/META-INF/maven/com.fasterxml.jackson.core; \
    cp -R relocated/shaded original/; \
    if [ -d relocated/META-INF/maven/com.fasterxml.jackson.core ]; then \
      mkdir -p original/META-INF/maven; \
      cp -R relocated/META-INF/maven/com.fasterxml.jackson.core original/META-INF/maven/; \
    fi; \
    (cd original && jar cfm "../out/${parquet_jar}" META-INF/MANIFEST.MF .); \
    jar tf "out/${parquet_jar}" | grep -q 'shaded/parquet/com/fasterxml/jackson/databind/ObjectMapper.class'; \
    mkdir -p /tmp/lz4-patch /tmp/jsoup-patch /tmp/tika-patch; \
    download_verified \
      "at/yawk/lz4/lz4-java/${LZ4_VERSION}/lz4-java-${LZ4_VERSION}.jar" \
      0db8664f43cc4e0f5af07d7adbac7ba5a1137e8cf15379fa749c3b5a483b2f639d609b6e4acecfb6caeac5a5e11bc4a909ef4dae54e82915f3954e74d6d0b62e \
      "/tmp/lz4-patch/lz4-java-${LZ4_VERSION}.jar"; \
    download_verified \
      "org/jsoup/jsoup/${JSOUP_VERSION}/jsoup-${JSOUP_VERSION}.jar" \
      b9d688df29faac621391d4f1a3391bbd756b74cdc3294ed15ae515eb9ae47eb81a8ec1ae3db4081c07a98129b03d3b24eba1dedce754328d8142c256a7ff0622 \
      "/tmp/jsoup-patch/jsoup-${JSOUP_VERSION}.jar"; \
    download_tika() { \
      artifact="$1"; \
      expected_sha512="$2"; \
      download_verified \
        "org/apache/tika/${artifact}/${TIKA_VERSION}/${artifact}-${TIKA_VERSION}.jar" \
        "${expected_sha512}" \
        "/tmp/tika-patch/${artifact}-${TIKA_VERSION}.jar"; \
    }; \
    download_tika tika-core cea49d264c1410af6d9208f447e16b6db78c75aec4a11cec74e90dd86847207996656c4223160724626374153603451ab4be177b01eb72236cc7ad0bd25c432b; \
    download_tika tika-langdetect-tika 15316cc73db10551bc0cd3313f3dbb4c9fbbe6524b6599b1aefd29d83f491ef7b373537b66dbfab70da3648251ea8b201d089a1e7d024c8f4e9e556218db429c; \
    download_tika tika-parser-apple-module e199c6d0eeed2fb3d2cd8d1c1249cabfda3a2d9fac7b3bffa50ada6e5e14d7d2635946242edede842367d8b1a274f3da3db9f781a85038e52e409ccb4cf3e22a; \
    download_tika tika-parser-html-module cac14326352eed4c690c6644ea6adf509a8df99428b45e10340c2c817ddd8ca08a66d1082b48ac3de6fbafeda969e9f23f134dc33a02c40e362981aef78d8b92; \
    download_tika tika-parser-microsoft-module fb45007525d81b2a3dd151b7c65ef8b7ec849e8ee20607c095d25c3e725e42459e4da587d46b16996b602386dfce48016fd00539e03526de47d23a0173ef1e05; \
    download_tika tika-parser-miscoffice-module 01796f03c853dab8051ad2d55874c7aabed269faa3465d1fb2e9c762b0bf75d77676137c7286292b6dfbeb34715af52bde8027ce1186ba8d543f17f5cd200bdf; \
    download_tika tika-parser-pdf-module 1a8756c6da5e45b376e52252bbde8873b3adffae81221f699eb6bbac42a25f54ba2bf1b891d4b40b1fd8cdf341f8eef6c672d7b6936bdaeaca388c88ee6d757d; \
    download_tika tika-parser-text-module 27c88cddd03cfef85d94c0daeba803e9feae44e6d33fc67e2abae90a3b73e46014c5ad7efd868ba3ae1b59fd2acd6d9d38e7e1c5230cb1e315e0fdb6746ef475; \
    download_tika tika-parser-xml-module ee6ed877537a0202e03dd1902c37e1cf18b67828c6ba67baf8a7c3fa1a7415dd4481c6fb373d83c121f007260f14f16991088dd49be49298e1b70588d13c7f2a; \
    download_tika tika-parser-xmp-commons 542a11af2bf87edc3d9f8333679e4b662eca3e39518c1b43351a6aa4bb0b5646128104b82d7291b68c12c5aa75990b95cd0cc5a6ed1b9e72cebd0e842f491413; \
    download_tika tika-parser-zip-commons 410303c1757d3064e250c27a46d16c190bd8c76acc23d5c3b50e190de254ea053bc1e24b16297ad03cf44a3b6ec4c4e93f7288030e0bbc3832d3184802bbed9f

FROM ${BASE_IMAGE}

ARG RELEASE_VERSION=2.2.2
ARG SOURCE_REVISION=unknown
ARG PARQUET_HADOOP_BUNDLE_VERSION=1.18.1
ARG OLD_LZ4_VERSION=1.11.1
ARG LZ4_VERSION=1.11.4
ARG OLD_JSOUP_VERSION=1.21.2
ARG JSOUP_VERSION=1.23.2
ARG OLD_TIKA_VERSION=3.2.3
ARG TIKA_VERSION=3.3.2

LABEL org.opencontainers.image.title="ElasticRune" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      org.opencontainers.image.description="Hardened Elasticsearch distribution with Azure snapshot repository support" \
      org.opencontainers.image.source="https://github.com/Jahrkor/elasticsearch-docker" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.licenses="Elastic-License-2.0" \
      org.opencontainers.image.vendor="hrafnox" \
      org.opencontainers.image.base.name="docker.elastic.co/elasticsearch/elasticsearch-wolfi:9.4.8-amd64"

USER 0

COPY --from=dependency-patches /tmp/parquet-jackson-patch/out/parquet-hadoop-bundle-${PARQUET_HADOOP_BUNDLE_VERSION}.jar /tmp/parquet-hadoop-bundle-patched.jar
COPY --from=dependency-patches /tmp/lz4-patch/ /tmp/lz4-patch/
COPY --from=dependency-patches /tmp/jsoup-patch/ /tmp/jsoup-patch/
COPY --from=dependency-patches /tmp/tika-patch/ /tmp/tika-patch/

RUN set -eu; \
    apk update; \
    apk upgrade --no-cache; \
    rm -rf /var/cache/apk/*; \
    parquet_replaced=0; \
    for old_jar in $(find /usr/share/elasticsearch/modules -type f -name "parquet-hadoop-bundle-${PARQUET_HADOOP_BUNDLE_VERSION}.jar" | sort); do \
      cp /tmp/parquet-hadoop-bundle-patched.jar "${old_jar}"; \
      chown 0:0 "${old_jar}"; \
      chmod 0444 "${old_jar}"; \
      parquet_replaced=$((parquet_replaced + 1)); \
    done; \
    if [ "${parquet_replaced}" -ne 2 ]; then \
      echo "Expected two Parquet bundles, replaced ${parquet_replaced}" >&2; \
      exit 1; \
    fi; \
    old_lz4="/usr/share/elasticsearch/lib/lz4-java-${OLD_LZ4_VERSION}.jar"; \
    new_lz4="/usr/share/elasticsearch/lib/lz4-java-${LZ4_VERSION}.jar"; \
    if [ ! -f "${old_lz4}" ]; then \
      echo "Missing LZ4 replacement target: ${old_lz4}" >&2; \
      exit 1; \
    fi; \
    rm "${old_lz4}"; \
    cp "/tmp/lz4-patch/lz4-java-${LZ4_VERSION}.jar" "${new_lz4}"; \
    chown 0:0 "${new_lz4}"; \
    chmod 0444 "${new_lz4}"; \
    old_jsoup="/usr/share/elasticsearch/modules/ingest-attachment/jsoup-${OLD_JSOUP_VERSION}.jar"; \
    new_jsoup="/usr/share/elasticsearch/modules/ingest-attachment/jsoup-${JSOUP_VERSION}.jar"; \
    if [ ! -f "${old_jsoup}" ]; then \
      echo "Missing jsoup replacement target: ${old_jsoup}" >&2; \
      exit 1; \
    fi; \
    rm "${old_jsoup}"; \
    cp "/tmp/jsoup-patch/jsoup-${JSOUP_VERSION}.jar" "${new_jsoup}"; \
    chown 0:0 "${new_jsoup}"; \
    chmod 0444 "${new_jsoup}"; \
    tika_replaced=0; \
    for replacement in /tmp/tika-patch/tika-*-${TIKA_VERSION}.jar; do \
      file_name="${replacement##*/}"; \
      artifact="${file_name%-${TIKA_VERSION}.jar}"; \
      old_jar="/usr/share/elasticsearch/modules/ingest-attachment/${artifact}-${OLD_TIKA_VERSION}.jar"; \
      if [ ! -f "${old_jar}" ]; then \
        echo "Missing exact Tika replacement target: ${old_jar}" >&2; \
        exit 1; \
      fi; \
      rm "${old_jar}"; \
      cp "${replacement}" "/usr/share/elasticsearch/modules/ingest-attachment/${file_name}"; \
      chown 0:0 "/usr/share/elasticsearch/modules/ingest-attachment/${file_name}"; \
      chmod 0444 "/usr/share/elasticsearch/modules/ingest-attachment/${file_name}"; \
      tika_replaced=$((tika_replaced + 1)); \
    done; \
    if [ "${tika_replaced}" -ne 11 ]; then \
      echo "Expected 11 aligned Tika JARs, replaced ${tika_replaced}" >&2; \
      exit 1; \
    fi; \
    stale="$(find /usr/share/elasticsearch -type f \( \
      -name "lz4-java-${OLD_LZ4_VERSION}.jar" -o \
      -name "jsoup-${OLD_JSOUP_VERSION}.jar" -o \
      -name "tika-*-${OLD_TIKA_VERSION}.jar" \
    \) -print -quit)"; \
    if [ -n "${stale}" ]; then \
      echo "Stale vulnerable JAR remains: ${stale}" >&2; \
      exit 1; \
    fi; \
    test -f "${new_lz4}"; \
    test -f "${new_jsoup}"; \
    rm -rf /tmp/lz4-patch /tmp/jsoup-patch /tmp/tika-patch /tmp/parquet-hadoop-bundle-patched.jar

USER 1000:0
