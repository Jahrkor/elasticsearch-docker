        echo "Missing HttpComponents replacement pair: ${old_jar} -> ${replacement}" >&2; \
        exit 1; \
      fi; \
      rm "${old_jar}"; \
      cp "${replacement}" "/usr/share/elasticsearch/modules/x-pack-core/${artifact}-${HTTP_CORE_VERSION}.jar"; \
      chown 0:0 "/usr/share/elasticsearch/modules/x-pack-core/${artifact}-${HTTP_CORE_VERSION}.jar"; \
      chmod 0444 "/usr/share/elasticsearch/modules/x-pack-core/${artifact}-${HTTP_CORE_VERSION}.jar"; \
      httpcore_replaced=$((httpcore_replaced + 1)); \
    done; \
    if [ "${httpcore_replaced}" -ne 2 ]; then \
      echo "Expected to replace two HttpComponents Core JARs, replaced ${httpcore_replaced}" >&2; \
      exit 1; \
    fi; \
    stale_httpcore="$(find /usr/share/elasticsearch -type f \( -name "httpcore5-${OLD_HTTP_CORE_VERSION}.jar" -o -name "httpcore5-h2-${OLD_HTTP_CORE_VERSION}.jar" \) -print -quit)"; \
    if [ -n "${stale_httpcore}" ]; then \
      echo "Stale vulnerable HttpComponents JAR remains: ${stale_httpcore}" >&2; \
      exit 1; \
    fi; \
    tika_replaced=0; \
    for replacement in /tmp/tika-patch/tika-*-${TIKA_VERSION}.jar; do \
      file_name="${replacement##*/}"; \
      artifact="${file_name%-${TIKA_VERSION}.jar}"; \
      old_jar="/usr/share/elasticsearch/modules/ingest-attachment/${artifact}-${OLD_TIKA_VERSION}.jar"; \
      if [ ! -f "${old_jar}" ]; then \
        echo "Missing exact Tika replacement target: ${old_jar}" >&2; \
        exit 1; \
      fi; \
      rm "${old_jar}"; \
      cp "${replacement}" "/usr/share/elasticsearch/modules/ingest-attachment/${file_name}"; \
      chown 0:0 "/usr/share/elasticsearch/modules/ingest-attachment/${file_name}"; \
      chmod 0444 "/usr/share/elasticsearch/modules/ingest-attachment/${file_name}"; \
      tika_replaced=$((tika_replaced + 1)); \
    done; \
    if [ "${tika_replaced}" -ne 11 ]; then \
      echo "Expected to replace 11 aligned Tika JARs, replaced ${tika_replaced}" >&2; \
      exit 1; \
    fi; \
    stale_tika="$(find /usr/share/elasticsearch/modules/ingest-attachment -type f -name "tika-*-${OLD_TIKA_VERSION}.jar" -print -quit)"; \
    if [ -n "${stale_tika}" ]; then \
      echo "Stale vulnerable Tika JAR remains: ${stale_tika}" >&2; \
      exit 1; \
    fi; \
    jackson_replaced=0; \
    replace_jackson() { \
      module="$1"; \
      artifact="$2"; \
      old_jar="/usr/share/elasticsearch/modules/${module}/${artifact}-${OLD_JACKSON_VERSION}.jar"; \
      replacement="/tmp/jackson-patch/${artifact}-${JACKSON_VERSION}.jar"; \
      if [ ! -f "${old_jar}" ] || [ ! -f "${replacement}" ]; then \
        echo "Missing exact Jackson replacement pair: ${old_jar} -> ${replacement}" >&2; \
        exit 1; \
      fi; \
      rm "${old_jar}"; \
      cp "${replacement}" "/usr/share/elasticsearch/modules/${module}/${artifact}-${JACKSON_VERSION}.jar"; \
      chown 0:0 "/usr/share/elasticsearch/modules/${module}/${artifact}-${JACKSON_VERSION}.jar"; \
      chmod 0444 "/usr/share/elasticsearch/modules/${module}/${artifact}-${JACKSON_VERSION}.jar"; \
      jackson_replaced=$((jackson_replaced + 1)); \
    }; \
    for module in ingest-geoip x-pack-ent-search x-pack-esql; do \
