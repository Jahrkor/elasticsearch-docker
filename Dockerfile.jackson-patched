FROM ${BASE_IMAGE}

ARG RELEASE_VERSION
ARG PARQUET_HADOOP_BUNDLE_VERSION=1.17.1
ARG OLD_NETTY_VERSION=4.1.135.Final
ARG NETTY_VERSION=4.1.137.Final
ARG OLD_HTTP_CORE_VERSION=5.3.5
ARG HTTP_CORE_VERSION=5.4.3
ARG OLD_TIKA_VERSION=3.2.3
