      done; \
    done; \
    for module in repository-azure x-pack-inference; do \
      for artifact in jackson-annotations jackson-core jackson-databind jackson-dataformat-xml jackson-datatype-jsr310 jackson-module-jaxb-annotations; do \
        replace_jackson "${module}" "${artifact}"; \
      done; \
    done; \
    if [ "${jackson_replaced}" -ne 21 ]; then \
      echo "Expected to replace 21 module-aligned Jackson JARs, replaced ${jackson_replaced}" >&2; \
      exit 1; \
    fi; \
    for module in ingest-geoip repository-azure x-pack-ent-search x-pack-esql x-pack-inference; do \
      stale_jackson="$(find "/usr/share/elasticsearch/modules/${module}" -type f -name "jackson-*-${OLD_JACKSON_VERSION}.jar" -print -quit)"; \
      if [ -n "${stale_jackson}" ]; then \
        echo "Stale vulnerable Jackson JAR remains: ${stale_jackson}" >&2; \
        exit 1; \
      fi; \
    done; \
    rm -rf /tmp/httpcore-patch /tmp/jackson-patch /tmp/netty-patch /tmp/tika-patch /tmp/parquet-hadoop-bundle-patched.jar

